{
  "name": "kittymech-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n arena,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:web": "vite --host 0.0.0.0",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "assets:export": "python tools/export_legacy.py",
    "assets:optimize": "tsx tools/optimize-assets.ts",
    "assets:validate": "tsx tools/validate-assets.ts",
    "review:fingerprint": "tsx tools/critical-review.ts --fingerprint",
    "review:check": "tsx tools/critical-review.ts",
    "release:check": "npm run lint && npm test && npm run build && npm run assets:validate && npm run review:check",
    "storage:check": "pwsh -NoProfile -File tools/storage-retention.ps1 -CheckBudget",
    "storage:clean": "pwsh -NoProfile -File tools/storage-retention.ps1 -Apply -CheckBudget",
    "prebuild": "npm run storage:clean"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.2",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.1.3",
    "@react-three/rapier": "^2.0.0",
    "peerjs": "^1.5.5",
    "postprocessing": "^6.39.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@gltf-transform/core": "^4.2.0",
    "@gltf-transform/extensions": "^4.2.0",
    "@gltf-transform/functions": "^4.2.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "meshoptimizer": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
